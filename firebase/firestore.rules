rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if request is by the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user has admin claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Users and Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    match /studentProfiles/{profileId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isOwner(request.resource.data.userId) || isAdmin();
    }

    // Student Survey Submissions
    match /surveys/{surveyId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Trackers: Sleep, Meals, Mood, Study Tasks
    match /sleepRecords/{recordId} {
      allow read, write: if isOwner(resource.data.userId) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /mealRecords/{recordId} {
      allow read, write: if isOwner(resource.data.userId) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /moodRecords/{recordId} {
      allow read, write: if isOwner(resource.data.userId) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /studyTasks/{taskId} {
      allow read, write: if isOwner(resource.data.userId) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Wellness challenges catalogue (public read)
    match /wellnessChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
